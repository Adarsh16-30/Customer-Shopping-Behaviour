# Copy to terraform.tfvars and fill in with real values. Bucket names must
# be globally unique across all of S3, so add your own suffix.

aws_region                = "ap-south-1"
raw_bucket_name           = "customer-shopping-behaviour-raw-<your-suffix>"
transformed_bucket_name   = "customer-shopping-behaviour-transformed-<your-suffix>"
glue_script_s3_uri        = "s3://customer-shopping-behaviour-raw-<your-suffix>/scripts/CleaningAndTransforming.py"
alarm_notification_email  = "you@example.com"
